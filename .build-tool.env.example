# Per-checkout settings for build and build-tool. Copy to .build-tool.env and
# edit; both scripts source that file when it sits beside them. Every setting
# is optional, and a step whose host is unset is skipped, not failed. Write
# VAR=${VAR-value} to let a value already in the environment win.

# FTP deploy of update.u64 by ./build
#DEPLOY_HOST=my-u64
#DEPLOY_PATH=/Usb1/firmware/u64/custom

# Post-deploy REST checks after a JTAG or FTP deploy
#U64_VERIFY_HOST=my-u64
#U64II_VERIFY_HOST=my-c64u

# FT232H for the Ultimate 64 Elite II / C64 Ultimate (pyftdi URL)
#U64II_JTAG_URL=ftdi://ftdi:232h/1

# Intel FPGA tools for the u64 JTAG deploy, when not found automatically
#INTEL_FPGA_ROOT=/opt/intelFPGA_lite/18.1
